<?xml version="1.0"?>
<package format="3">
  <name>gz_link_attacher</name>
  <version>0.1.0</version>
  <description>Gz Sim link attacher plugin and ROS 2 bridge for runtime pick-and-place</description>
  <maintainer email="raghav@todo.todo">raghav</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz-sim8</depend>
  <depend>gz-plugin2</depend>
  <depend>gz-common5</depend>
  <depend>gz-transport13</depend>
  <depend>gz-msgs10</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>linkattacher_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
